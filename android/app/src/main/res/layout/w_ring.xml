<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/w_bg_dark" android:orientation="vertical" android:gravity="center" android:padding="10dp">
    <TextView android:id="@+id/w_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Today" android:textSize="13sp" android:textColor="#9AA0A6" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
    <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp">
        <ImageView android:id="@+id/w_ring" android:layout_width="92dp" android:layout_height="92dp"
            android:importantForAccessibility="no"/>
        <LinearLayout android:layout_width="92dp" android:layout_height="92dp" android:orientation="vertical"
            android:gravity="center">
            <TextView android:id="@+id/w_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3/5" android:textSize="22sp" android:textColor="#ECEDF0" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/w_pct" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="60%" android:textSize="12sp" android:textColor="#CDBDFF" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </FrameLayout>
    <TextView android:id="@+id/w_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2 left" android:textSize="11sp" android:textColor="#9AA0A6" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="4dp"/>
</LinearLayout>
