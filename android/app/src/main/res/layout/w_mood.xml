<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/w_bg_dark" android:orientation="vertical" android:padding="12dp">
    <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Quote of the day" android:textSize="11sp" android:textStyle="bold" android:textColor="#CDBDFF"
        android:textAlignment="viewStart" android:maxLines="1" android:ellipsize="end"/>
    <TextView android:id="@+id/w_quote" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="4dp" android:gravity="center_vertical"
        android:text="Small habits today create big results tomorrow." android:textSize="13sp"
        android:textColor="#ECEDF0" android:textAlignment="viewStart" android:maxLines="4" android:ellipsize="end"/>
    <TextView android:id="@+id/w_ask" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="How do you feel today?" android:textSize="11sp" android:textColor="#9AA0A6"
        android:textAlignment="viewStart" android:maxLines="1" android:ellipsize="end"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:orientation="horizontal">
        <TextView android:id="@+id/w_m1" android:layout_width="0dp" android:layout_height="34dp"
            android:layout_weight="1" android:layout_marginStart="1dp" android:layout_marginEnd="1dp"
            android:gravity="center" android:text="😞" android:textSize="18sp"/>
        <TextView android:id="@+id/w_m2" android:layout_width="0dp" android:layout_height="34dp"
            android:layout_weight="1" android:layout_marginStart="1dp" android:layout_marginEnd="1dp"
            android:gravity="center" android:text="😐" android:textSize="18sp"/>
        <TextView android:id="@+id/w_m3" android:layout_width="0dp" android:layout_height="34dp"
            android:layout_weight="1" android:layout_marginStart="1dp" android:layout_marginEnd="1dp"
            android:gravity="center" android:text="🙂" android:textSize="18sp"/>
        <TextView android:id="@+id/w_m4" android:layout_width="0dp" android:layout_height="34dp"
            android:layout_weight="1" android:layout_marginStart="1dp" android:layout_marginEnd="1dp"
            android:gravity="center" android:text="😀" android:textSize="18sp"/>
        <TextView android:id="@+id/w_m5" android:layout_width="0dp" android:layout_height="34dp"
            android:layout_weight="1" android:layout_marginStart="1dp" android:layout_marginEnd="1dp"
            android:gravity="center" android:text="🤩" android:textSize="18sp"/>
    </LinearLayout>
</LinearLayout>
