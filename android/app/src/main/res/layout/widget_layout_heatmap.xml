<?xml version="1.0" encoding="utf-8"?>
<!-- HabitFlow - 7-day heat strip widget (short wide) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/heatTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="آخر 7 أيام"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/heatStreak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="4dp"
            android:text="🔥 0"
            android:textColor="#FFA000"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/heatPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            android:text="0%"
            android:textColor="#9B6DFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/heatDay0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="ج"
            android:textColor="#9AA0A6"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/heatDay1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="خ"
            android:textColor="#9AA0A6"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/heatDay2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="ر"
            android:textColor="#9AA0A6"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/heatDay3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="ث"
            android:textColor="#9AA0A6"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/heatDay4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="ا"
            android:textColor="#9AA0A6"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/heatDay5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="أ"
            android:textColor="#9AA0A6"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/heatDay6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="س"
            android:textColor="#9AA0A6"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/heatEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="لا توجد عادات بعد — افتح التطبيق لبدء رحلتك 🎯"
        android:textColor="#9AA0A6"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/heatRows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical">

        <!-- row 0 -->
        <LinearLayout
            android:id="@+id/heatRow0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/heatName0"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="—"
                android:textColor="#ECECEC"
                android:textSize="11sp" />

            <ImageView
                android:id="@+id/heatDot0_0"
                android:layout_width="0dp"
                android:layout_height="14dp"
                android:layout_marginRight="3dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/heatDot0_1"
                android:layout_width="0dp"
                android:layout_height="14dp"
                android:layout_marginRight="3dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/heatDot0_2"
                android:layout_width="0dp"
                android:layout_height="14dp"
                android:layout_marginRight="3dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/heatDot0_3"
                android:layout_width="0dp"
                android:layout_height="14dp"
                android:layout_marginRight="3dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/heatDot0_4"
                android:layout_width="0dp"
                android:layout_height="14dp"
                android:layout_marginRight="3dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/heatDot0_5"
                android:layout_width="0dp"
                android:layout_height="14dp"
                android:layout_marginRight="3dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/heatDot0_6"
                android:layout_width="0dp"
                android:layout_height="14dp"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- row 1 -->
        <LinearLayout
            android:id="@+id/heatRow1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/heatName1"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="—"
                android:textColor="#ECECEC"
                android:textSize="11sp" />

            <ImageView
                android:id="@+id/heatDot1_0"
                android:layout_width="0dp"
                android:layout_height="14dp"
                android:layout_marginRight="3dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/heatDot1_1"
                android:layout_width="0dp"
                android:layout_height="14dp"
                android:layout_marginRight="3dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/heatDot1_2"
                android:layout_width="0dp"
                android:layout_height="14dp"
                android:layout_marginRight="3dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/heatDot1_3"
                android:layout_width="0dp"
                android:layout_height="14dp"
                android:layout_marginRight="3dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/heatDot1_4"
                android:layout_width="0dp"
                android:layout_height="14dp"
                android:layout_marginRight="3dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/heatDot1_5"
                android:layout_width="0dp"
                android:layout_height="14dp"
                android:layout_marginRight="3dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/heatDot1_6"
                android:layout_width="0dp"
                android:layout_height="14dp"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- row 2 -->
        <LinearLayout
            android:id="@+id/heatRow2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/heatName2"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="—"
                android:textColor="#ECECEC"
                android:textSize="11sp" />

            <ImageView
                android:id="@+id/heatDot2_0"
                android:layout_width="0dp"
                android:layout_height="14dp"
                android:layout_marginRight="3dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/heatDot2_1"
                android:layout_width="0dp"
                android:layout_height="14dp"
                android:layout_marginRight="3dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/heatDot2_2"
                android:layout_width="0dp"
                android:layout_height="14dp"
                android:layout_marginRight="3dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/heatDot2_3"
                android:layout_width="0dp"
                android:layout_height="14dp"
                android:layout_marginRight="3dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/heatDot2_4"
                android:layout_width="0dp"
                android:layout_height="14dp"
                android:layout_marginRight="3dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/heatDot2_5"
                android:layout_width="0dp"
                android:layout_height="14dp"
                android:layout_marginRight="3dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/heatDot2_6"
                android:layout_width="0dp"
                android:layout_height="14dp"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- row 3 -->
        <LinearLayout
            android:id="@+id/heatRow3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/heatName3"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="—"
                android:textColor="#ECECEC"
                android:textSize="11sp" />

            <ImageView
                android:id="@+id/heatDot3_0"
                android:layout_width="0dp"
                android:layout_height="14dp"
                android:layout_marginRight="3dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/heatDot3_1"
                android:layout_width="0dp"
                android:layout_height="14dp"
                android:layout_marginRight="3dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/heatDot3_2"
                android:layout_width="0dp"
                android:layout_height="14dp"
                android:layout_marginRight="3dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/heatDot3_3"
                android:layout_width="0dp"
                android:layout_height="14dp"
                android:layout_marginRight="3dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/heatDot3_4"
                android:layout_width="0dp"
                android:layout_height="14dp"
                android:layout_marginRight="3dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/heatDot3_5"
                android:layout_width="0dp"
                android:layout_height="14dp"
                android:layout_marginRight="3dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/heatDot3_6"
                android:layout_width="0dp"
                android:layout_height="14dp"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- row 4 -->
        <LinearLayout
            android:id="@+id/heatRow4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/heatName4"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="—"
                android:textColor="#ECECEC"
                android:textSize="11sp" />

            <ImageView
                android:id="@+id/heatDot4_0"
                android:layout_width="0dp"
                android:layout_height="14dp"
                android:layout_marginRight="3dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/heatDot4_1"
                android:layout_width="0dp"
                android:layout_height="14dp"
                android:layout_marginRight="3dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/heatDot4_2"
                android:layout_width="0dp"
                android:layout_height="14dp"
                android:layout_marginRight="3dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/heatDot4_3"
                android:layout_width="0dp"
                android:layout_height="14dp"
                android:layout_marginRight="3dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/heatDot4_4"
                android:layout_width="0dp"
                android:layout_height="14dp"
                android:layout_marginRight="3dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/heatDot4_5"
                android:layout_width="0dp"
                android:layout_height="14dp"
                android:layout_marginRight="3dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/heatDot4_6"
                android:layout_width="0dp"
                android:layout_height="14dp"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>