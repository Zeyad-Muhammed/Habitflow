<?xml version="1.0" encoding="utf-8"?>
<!-- HabitFlow - single habit week check widget (wide & short) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/sName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="Habit"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sStreak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:text="🔥 0"
                android:textColor="#FFA000"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/sFreq"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Everyday"
            android:textColor="#9AA0A6"
            android:textSize="10sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/wl0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="س"
                    android:textColor="#9AA0A6"
                    android:textSize="9sp" />

                <ImageView
                    android:id="@+id/wc0"
                    android:layout_width="30dp"
                    android:layout_height="30dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/wl1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="أ"
                    android:textColor="#9AA0A6"
                    android:textSize="9sp" />

                <ImageView
                    android:id="@+id/wc1"
                    android:layout_width="30dp"
                    android:layout_height="30dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/wl2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ا"
                    android:textColor="#9AA0A6"
                    android:textSize="9sp" />

                <ImageView
                    android:id="@+id/wc2"
                    android:layout_width="30dp"
                    android:layout_height="30dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/wl3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ث"
                    android:textColor="#9AA0A6"
                    android:textSize="9sp" />

                <ImageView
                    android:id="@+id/wc3"
                    android:layout_width="30dp"
                    android:layout_height="30dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/wl4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ر"
                    android:textColor="#9AA0A6"
                    android:textSize="9sp" />

                <ImageView
                    android:id="@+id/wc4"
                    android:layout_width="30dp"
                    android:layout_height="30dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/wl5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="خ"
                    android:textColor="#9AA0A6"
                    android:textSize="9sp" />

                <ImageView
                    android:id="@+id/wc5"
                    android:layout_width="30dp"
                    android:layout_height="30dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/wl6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ج"
                    android:textColor="#9AA0A6"
                    android:textSize="9sp" />

                <ImageView
                    android:id="@+id/wc6"
                    android:layout_width="30dp"
                    android:layout_height="30dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/sTap"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>