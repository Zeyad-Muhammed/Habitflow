<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/w_bg_dark" android:orientation="vertical" android:gravity="center" android:padding="10dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔒"
        android:textSize="18sp"/>
    <TextView android:id="@+id/w_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HabitFlow Pro" android:textSize="14sp" android:textColor="#ECEDF0" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/w_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Upgrade to Pro to unlock this widget" android:textSize="11sp" android:textColor="#9AA0A6" android:maxLines="1" android:ellipsize="end" android:gravity="center"/>
    <TextView android:id="@+id/w_cta" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:background="@drawable/w_chip_on_dark" android:paddingStart="14dp"
        android:paddingEnd="14dp" android:paddingTop="5dp" android:paddingBottom="5dp" android:text="Upgrade to Pro"
        android:textSize="12sp" android:textStyle="bold" android:textColor="#2B1F4A" android:maxLines="1"/>
</LinearLayout>
